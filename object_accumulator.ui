           <item row="0" column="1">
            <widget class="QSpinBox" name="display_every_spin">
             <property name="toolTip">
              <string>Request a redraw only every N accepted frames. Accumulation never waits for the display either way.</string>
             </property>
             <property name="suffix">
              <string> frame(s)</string>
             </property>
             <property name="minimum">
              <number>1</number>
             </property>
             <property name="maximum">
              <number>999</number>
             </property>
             <property name="value">
              <number>1</number>
             </property>
            </widget>
           </item>
           <item row="1" column="0" colspan="2">
            <widget class="QCheckBox" name="accum_autolevel_check">
             <property name="text">
              <string>Auto colorscale</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QGroupBox" name="controls_group">
          <property name="title">
           <string>Control</string>
          </property>
          <layout class="QGridLayout" name="controls_grid">
