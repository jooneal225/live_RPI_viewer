              <string>Save object…</string>
             </property>
            </widget>
           </item>
           <item row="2" column="0">
            <widget class="QPushButton" name="show_tracker_btn">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Open a one-shot snapshot of the pixel-contribution tracker. Does not update live.</string>
             </property>
             <property name="text">
              <string>Contribution map</string>
             </property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QPushButton" name="close_btn">
